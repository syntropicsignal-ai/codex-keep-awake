{
  "description": "Manage one shared macOS idle-sleep assertion for active Codex turns.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -r \"${PLUGIN_ROOT}/scripts/awake.py\" ]; then python3 \"${PLUGIN_ROOT}/scripts/awake.py\" acquire; fi"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -r \"${PLUGIN_ROOT}/scripts/awake.py\" ]; then python3 \"${PLUGIN_ROOT}/scripts/awake.py\" subagent-start; fi"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -r \"${PLUGIN_ROOT}/scripts/awake.py\" ]; then python3 \"${PLUGIN_ROOT}/scripts/awake.py\" subagent-stop; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -r \"${PLUGIN_ROOT}/scripts/awake.py\" ]; then python3 \"${PLUGIN_ROOT}/scripts/awake.py\" release; else printf '{}\\n'; fi"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -r \"${PLUGIN_ROOT}/scripts/awake.py\" ]; then python3 \"${PLUGIN_ROOT}/scripts/awake.py\" release; fi",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
